# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Google Drive OAuth client credentials (per-user, never committed) —
# see lib/config/drive_oauth_config.dart and README.md's Drive Sync section.
oauth_config.json

# Code-signing certificate (private key — never committed).
windows/*.pfx
*.msix

# Vendored native libraries (Hunspell, Vosk) ARE meant to be committed —
# see BUILD_LOG.md's Phase 4.5/1.3 sections for why they're vendored rather
# than fetched at build time. Un-ignore them here since a machine-wide
# `*.dll` rule in this developer's global gitignore would otherwise silently
# exclude every DLL in the repo, including these legitimately-vendored ones.
!windows/hunspell/*.dll
!windows/vosk/*.dll

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
